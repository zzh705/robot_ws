<?xml version="1.0"?>
<robot name="library_robot">

  <!-- ========================= -->
  <!-- 1. 机器人脚底坐标系        -->
  <!-- ========================= -->
  <link name="base_footprint"/>


  <!-- ========================= -->
  <!-- 2. 机器人主体              -->
  <!-- 实测尺寸：0.33(长) × 0.25(宽) × 0.37(高) m -->
  <!-- ========================= -->
  <link name="base_link">

    <visual>
      <origin xyz="0 0 0.185" rpy="0 0 0"/>

      <geometry>
        <box size="0.33 0.25 0.37"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0.185" rpy="0 0 0"/>

      <geometry>
        <box size="0.33 0.25 0.37"/>
      </geometry>
    </collision>

  </link>


  <!-- ========================= -->
  <!-- 3. base_footprint → base_link -->
  <!-- ========================= -->
  <joint name="base_footprint_to_base_link"
         type="fixed">

    <parent link="base_footprint"/>
    <child link="base_link"/>

    <origin xyz="0 0 0"
            rpy="0 0 0"/>

  </joint>


  <!-- ========================= -->
  <!-- 4. 激光雷达                -->
  <!-- 实测安装高度：离地 0.12 m   -->
  <!-- 朝向已实测确认 (2026-10-11): yaw=3.14159265(180°) 正确,      -->
  <!--   即雷达 0° 朝车尾 —— 不再是"待确认"。判据: 车头方向由电机  -->
  <!--   +PWM 定义(与雷达怎么装无关); 在车头正前方 25cm(与雷达同高) -->
  <!--   放/拿物体, 看 /scan 哪个扇区出现/消失近物, 该扇区就是车头  -->
  <!--   在激光系里的角度 θ_front, URDF 的 yaw = -θ_front。        -->
  <!--   实测 θ_front≈155° → yaw≈205°≈180°; 精度约 ±25°(单扇区定位 -->
  <!--   + 手放物体的目测偏差), 足以排除"装反 180°"这一假设, 也说明 -->
  <!--   现有 maps/library.pgm 无需重建。                          -->
  <!--   复测: python3 scripts/lidar_yaw_check.py 的 watch 模式     -->
  <!-- ========================= -->
  <link name="laser">

    <visual>
      <origin xyz="0 0 0"
              rpy="0 0 0"/>

      <geometry>
        <cylinder radius="0.04"
                   length="0.06"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0"
              rpy="0 0 0"/>

      <geometry>
        <cylinder radius="0.04"
                   length="0.06"/>
      </geometry>
    </collision>

  </link>


  <!-- ========================= -->
  <!-- 5. base_link → laser       -->
  <!-- ========================= -->
  <joint name="base_link_to_laser"
         type="fixed">

    <parent link="base_link"/>
    <child link="laser"/>

    <origin xyz="0 0 0.12"
            rpy="0 0 3.14159265"/>

  </joint>

</robot>
