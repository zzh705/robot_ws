<?xml version="1.0"?>
<robot name="library_robot">

  <!-- ========================= -->
  <!-- 1. 机器人脚底坐标系        -->
  <!-- ========================= -->
  <link name="base_footprint"/>


  <!-- ========================= -->
  <!-- 2. 机器人主体              -->
  <!-- 临时尺寸：0.50 × 0.40 × 0.20 m -->
  <!-- ========================= -->
  <link name="base_link">

    <visual>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>

      <geometry>
        <box size="0.50 0.40 0.20"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>

      <geometry>
        <box size="0.50 0.40 0.20"/>
      </geometry>
    </collision>

  </link>


  <!-- ========================= -->
  <!-- 3. base_footprint → base_link -->
  <!-- ========================= -->
  <joint name="base_footprint_to_base_link"
         type="fixed">

    <parent link="base_footprint"/>
    <child link="base_link"/>

    <origin xyz="0 0 0"
            rpy="0 0 0"/>

  </joint>


  <!-- ========================= -->
  <!-- 4. 激光雷达                -->
  <!-- 临时安装高度：0.25 m        -->
  <!-- ========================= -->
  <link name="laser">

    <visual>
      <origin xyz="0 0 0"
              rpy="0 0 0"/>

      <geometry>
        <cylinder radius="0.04"
                   length="0.06"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0"
              rpy="0 0 0"/>

      <geometry>
        <cylinder radius="0.04"
                   length="0.06"/>
      </geometry>
    </collision>

  </link>


  <!-- ========================= -->
  <!-- 5. base_link → laser       -->
  <!-- ========================= -->
  <joint name="base_link_to_laser"
         type="fixed">

    <parent link="base_link"/>
    <child link="laser"/>

    <origin xyz="0 0 0.25"
            rpy="0 0 0"/>

  </joint>

</robot>
